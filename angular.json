{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "ngx-password-strength-bar": {
      "projectType": "library",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss",
          "standalone": true
        },
        "@schematics/angular:directive": {
          "standalone": true
        },
        "@schematics/angular:pipe": {
          "standalone": true
        }
      },
      "root": "projects/ngx-password-strength-bar",
      "sourceRoot": "projects/ngx-password-strength-bar/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "options": {
            "project": "projects/ngx-password-strength-bar/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/ngx-password-strength-bar/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/ngx-password-strength-bar/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/ngx-password-strength-bar/tsconfig.spec.json",
            "buildTarget": "ngx-password-strength-bar:build:development"
          }
        }
      }
    },
    "ngx-password-strength-bar-app": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss",
          "standalone": true
        },
        "@schematics/angular:directive": {
          "standalone": true
        },
        "@schematics/angular:pipe": {
          "standalone": true
        }
      },
      "root": "projects/ngx-password-strength-bar-app",
      "sourceRoot": "projects/ngx-password-strength-bar-app/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": {
              "base": "dist/ngx-password-strength-bar-app"
            },
            "index": "projects/ngx-password-strength-bar-app/src/index.html",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "projects/ngx-password-strength-bar-app/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              "projects/ngx-password-strength-bar-app/src/favicon.ico",
              "projects/ngx-password-strength-bar-app/src/assets"
            ],
            "styles": [
              "projects/ngx-password-strength-bar-app/src/styles.scss"
            ],
            "scripts": [],
            "browser": "projects/ngx-password-strength-bar-app/src/main.ts"
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "2mb",
                  "maximumError": "5mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "6kb",
                  "maximumError": "10kb"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "namedChunks": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "ngx-password-strength-bar-app:build:production"
            },
            "development": {
              "buildTarget": "ngx-password-strength-bar-app:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n",
          "options": {
            "buildTarget": "ngx-password-strength-bar-app:build"
          }
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/ngx-password-strength-bar-app/tsconfig.spec.json",
            "buildTarget": "ngx-password-strength-bar-app:build:development"
          }
        }
      }
    }
  },
  "schematics": {
    "@schematics/angular:component": {
      "type": "component"
    },
    "@schematics/angular:directive": {
      "type": "directive"
    },
    "@schematics/angular:service": {
      "type": "service"
    },
    "@schematics/angular:guard": {
      "typeSeparator": "."
    },
    "@schematics/angular:interceptor": {
      "typeSeparator": "."
    },
    "@schematics/angular:module": {
      "typeSeparator": "."
    },
    "@schematics/angular:pipe": {
      "typeSeparator": "."
    },
    "@schematics/angular:resolver": {
      "typeSeparator": "."
    }
  }
}
